{
  "name": "speckub-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "lint": "eslint src",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mermaid-js/tiny": "^11.17.2",
    "markdown-it": "^14.1.0",
    "yaml": "^2.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@speckub/schema": "0.1.3",
    "@types/markdown-it": "^14.1.2",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
