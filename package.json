{
  "name": "speckub-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "preview": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run src",
    "lint": "eslint app src scripts next.config.ts playwright.config.ts e2e",
    "test:e2e": "playwright test",
    "predev": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-assets.mjs",
    "start": "next start --hostname 127.0.0.1"
  },
  "dependencies": {
    "@mermaid-js/tiny": "^11.17.2",
    "markdown-it": "^14.1.0",
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@speckub/schema": "0.1.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.25.1",
    "eslint-config-next": "16.4.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  }
}
